@using System.Globalization

<div class="trend-wrap">
<svg viewBox="0 0 320 140" class="trend" role="img" aria-label="@AriaLabel">
    <title>@AriaLabel</title>
    <line class="trend-axis" x1="10" y1="@N(Baseline)" x2="310" y2="@N(Baseline)"></line>
    @foreach(var bar in _bars){
        <rect class="@bar.Css" x="@N(bar.X)" y="@N(bar.Y)" width="@N(bar.Width)" height="@N(bar.Height)" rx="2">
            <title>@bar.Tooltip</title>
        </rect>
    }
</svg>
<div class="trend-labels" aria-hidden="true" style="grid-template-columns:repeat(@_labels.Count, 1fr)">
    @foreach(var label in _labels){
        <span>@label.Text</span>
    }
</div>
</div>
<div class="legend-inline">
    <span><span class="swatch swatch-income"></span> Income</span>
    <span><span class="swatch swatch-expense"></span> Expenses</span>
</div>

@code {
    private const double Baseline = 130;
    private const double PlotHeight = 110;
    private const double PlotLeft = 10;
    private const double PlotWidth = 300;

    private sealed record BarShape(string Css, double X, double Y, double Width, double Height, string Tooltip);

    private sealed record AxisLabel(double X, string Text);

    private readonly List<BarShape> _bars = new();
    private readonly List<AxisLabel> _labels = new();

    [Parameter, EditorRequired]
    public IReadOnlyList<MonthPoint> Points { get; set; } = Array.Empty<MonthPoint>();

    [Parameter]
    public string AriaLabel { get; set; } = "Income and expenses for the last months";

    protected override void OnParametersSet(){
        _bars.Clear();
        _labels.Clear();

        if(Points.Count == 0)
            return;

        var max = (double)Points.Max(p => Math.Max(p.Income, p.Expense));
        if(max <= 0)
            max = 1;

        var group = PlotWidth / Points.Count;
        var barWidth = Math.Min(24, group * 0.32);

        for(var i = 0; i < Points.Count; i++){
            var point = Points[i];
            var center = PlotLeft + group * i + group / 2;
            var incomeHeight = (double)point.Income / max * PlotHeight;
            var expenseHeight = (double)point.Expense / max * PlotHeight;
            var month = Display.Month(point.Month);

            _bars.Add(new BarShape("bar-income", center - barWidth - 1, Baseline - incomeHeight, barWidth, incomeHeight,
                $"{month}: income {Amount(point.Income)}"));
            _bars.Add(new BarShape("bar-expense", center + 1, Baseline - expenseHeight, barWidth, expenseHeight,
                $"{month}: expenses {Amount(point.Expense)}"));
            _labels.Add(new AxisLabel(center, Display.ShortMonth(point.Month)));
        }
    }

    private static string Amount(decimal value) => value.ToString("N2", CultureInfo.InvariantCulture);

    private static string N(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}
